Package: cooccure
Title: Co-Occurrence Network Construction and Manipulation
Version: 0.5.0
Authors@R: c(
    person("Mohammed", "Saqr", email = "saqr@saqr.me",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0001-5881-3109")),
